# Application Configuration
NODE_ENV=development
PORT=5000

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/crm-sales-management

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated or * for development)
CORS_ORIGIN=*
